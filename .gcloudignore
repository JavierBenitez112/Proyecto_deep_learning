# Lo que NO se sube a Cloud Build (gcloud run deploy --source .).
# Sin este archivo gcloud usaría .gitignore y dejaría fuera los datos y modelos que la imagen necesita.
.gcloudignore
.git
.venv
.claude
__pycache__
*.pyc
notebooks
reports
docs
data/raw
data/processed/transacciones_hm.csv
data/processed/mapeo_hm_siman.csv
